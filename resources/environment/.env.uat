# UAT environment configuration
# Replace every "your-..." placeholder before running tests.
# Tests stop with a clear error if a placeholder is still here.
# Read by src/config/ConfigReader.ts. A value set in the terminal
# (e.g. PowerShell: $env:BASE_URL="...") overrides the value in this file.
# Do not commit real Census IDs to shared locations.

# Full UAT login page URL, starting with http:// or https://
BASE_URL=https://your-census-uat-url

# Browser engine: chromium, firefox or webkit
BROWSER=chromium
# false = show the browser window; true = run hidden
HEADLESS=false
# Max wait for an element, in milliseconds (a Cucumber step may take up to twice this)
DEFAULT_TIMEOUT=30000

# Exactly 12 digits, no spaces or dashes
VALID_CENSUS_ID=your-valid-12-digit-test-id
# Not used by the current scenarios
INVALID_CENSUS_ID=your-invalid-test-id

# Census Day exactly as the application displays it.
# Replaces every {CENSUS_DAY} placeholder in resources/testdata/SpecText.json.
# Required for every test run while SpecText.json contains {CENSUS_DAY}
# (ConfigReader checks the JSON file before the browser starts).
CENSUS_DAY=your-census-day-as-displayed
